MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=schema
MYSQL_USER=user
MYSQL_PASSWORD=

# Destino dos fatos (Postgres local)
POSTGRES_URL=postgresql://postgres:senha@localhost:5432/schema

# --- Fase 4 / ask / narrador / insights LLM (faceta/ask/openai_client.py) ---
# LLM_API_KEY tem prioridade; OPENAI_API_KEY também é aceito como fallback
LLM_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
# Opcional: proxy / Azure / outro endpoint OpenAI-compatible
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Fase 5 / insights modelo (faceta/insights/model.py) ---
# Diretório dos autoencoders (default: <repo>/models/insights)
# TF_MODEL_PATH=models/insights
# Limiar de erro de reconstrução p/ disparar LLM.
# --- Dev / testes manuais (NUNCA no cron de produção) ---
# Libera --force-llm no insights (gera LLM sem sinal real de anomalia)
# FACETA_ALLOW_FORCE_LLM=1
